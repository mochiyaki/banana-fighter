# ---- Claude (optional: without a key the harness runs the rule-based agent/optimizer) ----
ANTHROPIC_API_KEY=
BF_MODEL=claude-opus-5
BF_AGENT_EFFORT=low          # per-move decisions: low | medium | high
BF_OPTIMIZER_EFFORT=high     # strategy rewrites: high | xhigh | max

# ---- Harness defaults (CLI flags override) ----
BF_AGENT=heuristic           # heuristic | llm | random
BF_OPTIMIZER=rule            # rule | llm
BF_ENV=banana-brawl

# ---- Storage: jsonl (default, ./memory) or mongo ----
BF_STORAGE=jsonl
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=banana_fighter

# ---- Telemetry: console always; Raindrop (raindrop.ai) when a key is set ----
RAINDROP_API_KEY=
RAINDROP_PROJECT_ID=
BF_RUN_USER=banana-fighter   # user_id reported to Raindrop
